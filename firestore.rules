rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Remplacer cette valeur par le même UID MJ que celui de tes règles actuelles.
    function isMJ() {
      return request.auth != null && request.auth.uid == 'REMPLACE_PAR_TON_UID_MJ';
    }
    function isGroup(groupId) {
      return groupId in ['groupe1', 'groupe2'];
    }
    // La collection historique est conservée, afin de pouvoir copier les anciens stocks.
    match /stocks/{stockId} {
      allow read: if true;
      allow create, update: if isMJ()
        && request.resource.data.keys().hasOnly(['item_id','stock'])
        && request.resource.data.keys().hasAll(['item_id','stock'])
        && request.resource.data.item_id is string
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
      allow delete: if isMJ();
    }
    // Les deux groupes possèdent des collections distinctes : aucune mutation croisée.
    match /groups/{groupId} {
      allow read, write: if false;
      match /stocks/{itemId} {
        allow read: if isGroup(groupId);
        allow create, update: if isGroup(groupId) && isMJ()
          && request.resource.data.keys().hasOnly(['stock','updatedAt'])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0 && request.resource.data.stock <= 1000000;
        allow delete: if isGroup(groupId) && isMJ();
      }
      match /customItems/{itemId} {
        allow read: if isGroup(groupId);
        allow create, update: if isGroup(groupId) && isMJ()
          && request.resource.data.keys().hasOnly(['name','category','subcategory','description','pricePC','icon','templateId','affixes','visible','updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 140
          && request.resource.data.category is string
          && request.resource.data.description is string
          && request.resource.data.icon is string
          && request.resource.data.visible is bool
          && request.resource.data.affixes is list
          && (request.resource.data.pricePC == null ||
              (request.resource.data.pricePC is int && request.resource.data.pricePC >= 0));
        allow delete: if isGroup(groupId) && isMJ();
      }
      match /baseOverrides/{itemId} {
        allow read: if isGroup(groupId);
        allow create, update: if isGroup(groupId) && isMJ()
          && request.resource.data.keys().hasOnly(['visible','pricePC','updatedAt'])
          && request.resource.data.visible is bool
          && (!('pricePC' in request.resource.data) ||
              (request.resource.data.pricePC is int && request.resource.data.pricePC >= 0));
        allow delete: if isGroup(groupId) && isMJ();
      }
    }
  }
}
